# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Sheets ──────────────────────────────────────────
# ID sheet kamu (dari URL: docs.google.com/spreadsheets/d/[ID]/edit)
GOOGLE_SHEETS_ID=your_sheet_id_here
SHEET_TAB_NAME=Sheet1

# Service Account credentials dari Google Cloud Console (satu baris JSON)
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Fonnte (WhatsApp) ──────────────────────────────────────
FONNTE_TOKEN=your_fonnte_token_here

# Nomor WA kamu untuk menerima notifikasi H-1 (format: 628xxxxxxxxxx)
YOUR_WA_NUMBER=628123456789

# ── Telegram ───────────────────────────────────────────────
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID untuk notifikasi H-1 (bisa personal atau grup)
# Cara cari: kirim pesan ke bot lalu buka https://api.telegram.org/bot[TOKEN]/getUpdates
TELEGRAM_NOTIF_CHAT_ID=-1001234567890

# ── Server ─────────────────────────────────────────────────
PORT=3000
